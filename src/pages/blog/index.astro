---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { getAllTags } from '../../utils/tags';
import { localizedHref } from '../../utils/i18n';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = await getAllTags();
const title = `Blog — ${SITE_TITLE}`;
const description =
	"Technical notes by Albert Wang — Linux & Debian server setup, networking, data acquisition, and cloud/edge engineering.";
---

<!doctype html>
<html lang={Astro.currentLocale === 'zh' ? 'zh-TW' : 'en'}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: var(--maxw-wide);
				max-width: calc(100% - 2em);
			}
			.page-head {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.page-head h1 {
				margin-bottom: 0.3em;
			}
			.page-head p {
				max-width: 560px;
				margin: 0 auto;
				color: rgb(var(--gray));
			}
			.tag-bar {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.45em;
				margin: 0 auto 2.5em;
				max-width: 760px;
			}
			.tag-bar a {
				font-size: 0.8rem;
				font-weight: 600;
				padding: 0.4em 0.8em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent-dark);
				text-decoration: none;
				transition: background 0.15s, color 0.15s;
			}
			.tag-bar a:hover {
				background: var(--accent);
				color: #fff;
			}
			.posts {
				display: grid;
				/* Up to 4 per row: a 5th 220px track can't fit the 1080px container,
				   and columns fall to 3 → 2 → 1 automatically as the window narrows. */
				grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
				gap: 1.8em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			@media (max-width: 720px) {
				.posts {
					gap: 1.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<p class="eyebrow">Writing</p>
				<h1><span data-en>Blog</span><span data-zh>文章</span></h1>
				<p>
					<span data-en
						>Technical notes on Linux servers, networking, data acquisition, and
						cloud/edge engineering.</span
					>
					<span data-zh
						>關於 Linux 伺服器、網路、資料採集與雲端／邊緣工程的技術筆記。</span
					>
				</p>
			</div>

			<nav class="tag-bar" aria-label="Browse by tag">
				{tags.map((t) => <a href={localizedHref(Astro.currentLocale, `/tags/${t.slug}/`)}>#{t.tag} <span>({t.count})</span></a>)}
			</nav>

			<ul class="posts">
				{posts.map((post) => <PostCard post={post} />)}
			</ul>
		</main>
		<Footer />
	</body>
</html>
