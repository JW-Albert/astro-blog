---
import HeaderLink from './HeaderLink.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { localizedHref } from '../utils/i18n';
const homeHref = localizedHref(Astro.currentLocale, '/');
---

<header>
	<nav class="container">
		<a href={homeHref} class="brand">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/"><span data-en>Home</span><span data-zh>首頁</span></HeaderLink>
			<HeaderLink href="/blog"><span data-en>Blog</span><span data-zh>文章</span></HeaderLink>
			<HeaderLink href="/projects"><span data-en>Projects</span><span data-zh>作品</span></HeaderLink>
			<HeaderLink href="/cv"><span data-en>CV</span><span data-zh>履歷</span></HeaderLink>
			<HeaderLink href="/about"><span data-en>About</span><span data-zh>關於</span></HeaderLink>
		</div>
		<div class="right-controls">
			<ThemeToggle />
			<LangToggle />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--header-bg);
		backdrop-filter: saturate(180%) blur(10px);
		-webkit-backdrop-filter: saturate(180%) blur(10px);
		border-bottom: 1px solid rgb(var(--border));
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1em;
		padding: 0.6em 1em;
	}
	.brand {
		flex: 1;
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
		flex-wrap: wrap;
		justify-content: center;
	}
	.internal-links :global(a) {
		padding: 0.4em 0.7em;
		color: rgb(var(--gray-dark));
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.95rem;
		transition: background 0.15s, color 0.15s;
	}
	.internal-links :global(a:hover) {
		background: var(--accent-soft);
		color: var(--accent-dark);
		text-decoration: none;
	}
	.internal-links :global(a.active) {
		color: var(--accent-dark);
		background: var(--accent-soft);
		text-decoration: none;
		font-weight: 700;
	}
	.right-controls {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5em;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			gap: 0.35em;
			justify-content: center;
			padding: 0.4em 0.75em;
		}
		.brand {
			flex: 0 0 auto;
			font-size: 1.1rem;
		}
		.right-controls {
			flex: 0 0 auto;
		}
		.internal-links {
			order: 3;
			flex-basis: 100%;
			gap: 0.1em;
		}
		/* The header is sticky, so every pixel here is lost reading area. */
		.internal-links :global(a) {
			padding: 0.3em 0.6em;
			font-size: 0.9rem;
		}
		/* Comfortable thumb targets for the two icon-sized controls. */
		.right-controls :global(a),
		.right-controls :global(button) {
			min-width: 42px;
			min-height: 42px;
		}
	}
</style>
