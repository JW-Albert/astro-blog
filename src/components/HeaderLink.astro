---
import type { HTMLAttributes } from 'astro/types';
import { localizedHref } from '../utils/i18n';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
// Active state is computed against the neutral path (same on /zh/ pages);
// the rendered href is localized so navigation stays within the locale.
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
const localizedHrefValue = localizedHref(Astro.currentLocale, String(href));
---

<a href={localizedHrefValue} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		white-space: nowrap;
	}
</style>
