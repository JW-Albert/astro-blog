---
import type { Project } from '../data/projects';
type Props = { project: Project };
const { project } = Astro.props;
---

<article class="card project-card reveal">
	<div class="project-head">
		<h3 class="project-name">{project.name}</h3>
		<div class="meta">
			{project.lang && <span class="lang">{project.lang}</span>}
			{project.stars ? <span class="stars">★ {project.stars}</span> : null}
		</div>
	</div>

	<p class="project-desc">
		<span data-en>{project.descEn}</span>
		<span data-zh>{project.descZh}</span>
	</p>

	<div class="tags">
		{project.tags.map((t) => <span class="tag">{t}</span>)}
	</div>

	<a class="project-link" href={project.repo} target="_blank" rel="noopener">
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
			><path
				fill="currentColor"
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
			></path></svg
		>
		<span data-en>View on GitHub</span><span data-zh>在 GitHub 查看</span>
	</a>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		padding: 1.4em 1.5em;
		height: 100%;
	}
	.project-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75em;
		margin-bottom: 0.5em;
	}
	.project-name {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.3;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6em;
		flex-shrink: 0;
		font-size: 0.8rem;
		color: rgb(var(--gray));
		padding-top: 0.2em;
	}
	.lang {
		font-weight: 600;
	}
	.stars {
		color: #d97706;
		font-weight: 600;
	}
	.project-desc {
		margin: 0 0 1em;
		font-size: 0.92rem;
		line-height: 1.65;
		color: rgb(var(--gray-dark));
		flex: 1;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-bottom: 1.1em;
	}
	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--accent-dark);
		align-self: flex-start;
	}
	.project-link:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.project-link svg {
		flex-shrink: 0;
	}
</style>
