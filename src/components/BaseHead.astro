---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { htmlLang, localePaths } from '../utils/i18n';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;

// Locale-aware URLs. On /zh/ pages Astro.url.pathname is the neutral path
// (the i18n fallback rewrite strips the /zh prefix), so we rebuild both.
const currentLocale = Astro.currentLocale;
const lang = htmlLang(currentLocale);
const paths = localePaths(Astro.url.pathname);
const enHref = new URL(paths.en, Astro.site);
const zhHref = new URL(paths.zh, Astro.site);
const canonicalURL = currentLocale === 'zh' ? zhHref : enHref;
const ogImage = new URL(image, Astro.site);
---

<!-- Theme + language routing: run before first paint -->
<script is:inline>
	(function () {
		var d = document.documentElement;
		function applyTheme() {
			var t = localStorage.getItem('theme');
			if (t !== 'light' && t !== 'dark') {
				t =
					window.matchMedia &&
					window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			}
			d.dataset.theme = t;
		}
		applyTheme();
		if ('IntersectionObserver' in window) d.classList.add('reveal-ready');

		if (!window.__siteInit) {
			window.__siteInit = true;

			// Re-apply client-set <html> state after a view transition (the
			// incoming server HTML has neither data-theme nor .reveal-ready).
			document.addEventListener('astro:after-swap', function () {
				applyTheme();
				if ('IntersectionObserver' in window) d.classList.add('reveal-ready');
			});

			// Delegated handlers survive view-transition DOM swaps.
			document.addEventListener('click', function (e) {
				var theme = e.target.closest && e.target.closest('#theme-toggle');
				if (theme) {
					var n = d.dataset.theme === 'dark' ? 'light' : 'dark';
					d.dataset.theme = n;
					localStorage.setItem('theme', n);
					return;
				}
				var ltog = e.target.closest && e.target.closest('#lang-toggle');
				if (ltog) localStorage.setItem('lang', ltog.getAttribute('data-target') || 'en');
			});

			// Language routing — full page loads only. An explicit choice wins;
			// first visit auto-detects browser language (en -> zh only, so
			// crawlers indexing /zh/ pages are left alone).
			var saved = localStorage.getItem('lang');
			var path = location.pathname;
			var onZh = path === '/zh' || path.indexOf('/zh/') === 0;
			var go = function (p) {
				location.replace(p + location.search + location.hash);
			};
			if (saved === 'zh-TW' && !onZh) return go('/zh' + (path === '/' ? '/' : path));
			if (saved === 'en' && onZh) return go(path.replace(/^\/zh(?=\/|$)/, '') || '/');
			if (!saved && !onZh && (navigator.language || '').toLowerCase().indexOf('zh') === 0)
				return go('/zh' + (path === '/' ? '/' : path));
		}
	})();
</script>

<!-- Scroll-reveal: observe elements with .reveal, re-init after navigations -->
<script>
	function setupReveal() {
		if (!('IntersectionObserver' in window)) return;
		const els = document.querySelectorAll('.reveal:not(.is-visible)');
		if (!els.length) return;
		const io = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((en) => {
					if (en.isIntersecting) {
						en.target.classList.add('is-visible');
						obs.unobserve(en.target);
					}
				});
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
		);
		els.forEach((el) => io.observe(el));
	}
	setupReveal();
	document.addEventListener('astro:page-load', setupReveal);
</script>

<!-- SPA-like page transitions -->
<ClientRouter />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/JW-Albert_ICON.png" />
<link rel="apple-touch-icon" href="/JW-Albert_ICON.png" />
<meta name="theme-color" content="#ed5a1a" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL + language alternates -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="zh-TW" href={zhHref} />
<link rel="alternate" hreflang="x-default" href={enHref} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={lang === 'zh-TW' ? 'zh_TW' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'zh-TW' ? 'en_US' : 'zh_TW'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
